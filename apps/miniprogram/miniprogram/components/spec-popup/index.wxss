.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  opacity: 0;
  visibility: hidden;
  transition: opacity 0.25s ease, visibility 0.25s ease;
  z-index: 100;
}

.mask.show {
  opacity: 1;
  visibility: visible;
}

.popup {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  border-radius: 24rpx 24rpx 0 0;
  transform: translateY(100%);
  transition: transform 0.25s ease;
  z-index: 101;
  display: flex;
  flex-direction: column;
  max-height: 80vh;
}

.popup.show {
  transform: translateY(0);
}

.popup-head {
  display: flex;
  padding: 32rpx;
  position: relative;
  border-bottom: 1rpx solid var(--border);
}

.popup-pic {
  width: 140rpx;
  height: 140rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f1f2;
}

.popup-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.popup-name {
  font-size: 32rpx;
  font-weight: 600;
}

.popup-price {
  margin-top: 10rpx;
  color: var(--price);
  font-size: 36rpx;
  font-weight: 700;
}

.popup-price .rmb {
  font-size: 24rpx;
}

.popup-spec {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.popup-close {
  position: absolute;
  right: 24rpx;
  top: 24rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #f2f3f5;
  color: var(--text-2);
  font-size: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.popup-body {
  flex: 1;
  min-height: 0;
  padding: 8rpx 32rpx;
  max-height: 46vh;
}

.spec-group {
  padding: 24rpx 0;
}

.group-name {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 20rpx;
}

.group-options {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.option {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: #f2f3f5;
  color: var(--text-2);
  font-size: 26rpx;
}

.option.active {
  background: var(--brand-light);
  color: var(--brand);
  font-weight: 600;
  border: 2rpx solid var(--brand);
}

.qty-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0 40rpx;
}

.qty-row .group-name {
  margin-bottom: 0;
}

.popup-foot {
  padding: 20rpx 32rpx 28rpx;
  border-top: 1rpx solid var(--border);
}

.confirm-btn {
  height: 88rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}
