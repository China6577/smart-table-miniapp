.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0 60rpx;
}

/* CSS 绘制的餐盘图标 */
.empty-icon {
  width: 120rpx;
  height: 120rpx;
  border-radius: 50%;
  border: 6rpx solid #e3e5e7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.inner {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  border: 6rpx solid #e3e5e7;
}

.empty-text {
  margin-top: 24rpx;
  font-size: 28rpx;
  color: var(--text-3);
}

.empty-sub {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #b8b8b8;
}
