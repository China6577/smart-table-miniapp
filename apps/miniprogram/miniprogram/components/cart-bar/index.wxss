.cart-bar {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  bottom: calc(24rpx + env(safe-area-inset-bottom));
  height: 104rpx;
  background: #fff;
  border-radius: 52rpx;
  display: flex;
  align-items: center;
  padding-left: 16rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.12);
  z-index: 90;
}

.cart-icon {
  position: relative;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background-color: #d3d4d6;
  background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='none' stroke='%23ffffff' stroke-width='2' stroke-linecap='round' stroke-linejoin='round'><circle cx='9' cy='21' r='1'/><circle cx='20' cy='21' r='1'/><path d='M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6'/></svg>");
  background-repeat: no-repeat;
  background-position: center;
  background-size: 44rpx 44rpx;
  flex-shrink: 0;
}

.cart-icon.active {
  background-color: var(--brand);
}

/* 加购数量增加时的弹跳反馈：图标与角标同步 pop */
.cart-icon.pop {
  animation: icon-pop 0.4s ease;
}

@keyframes icon-pop {
  0% {
    transform: scale(1);
  }
  45% {
    transform: scale(1.28);
  }
  100% {
    transform: scale(1);
  }
}

.cart-badge.pop {
  animation: badge-pop 0.4s ease;
}

@keyframes badge-pop {
  0% {
    transform: scale(1);
  }
  45% {
    transform: scale(1.35);
  }
  100% {
    transform: scale(1);
  }
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 34rpx;
  height: 34rpx;
  line-height: 34rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: var(--price);
  color: #fff;
  font-size: 22rpx;
  text-align: center;
}

.cart-total {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.amount {
  color: var(--text);
  font-size: 36rpx;
  font-weight: 700;
}

.amount .rmb {
  font-size: 24rpx;
}

.hint {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 2rpx;
}

.submit {
  height: 104rpx;
  padding: 0 56rpx;
  border-radius: 52rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit.disabled {
  background: #c9c9c9;
}
