.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 220rpx;
}

/* ---------- 状态横幅 ---------- */

.status-banner {
  border-radius: var(--radius);
  padding: 40rpx 32rpx;
  color: #fff;
}

.status-banner.tone-active {
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
}

.status-banner.tone-done {
  background: linear-gradient(135deg, #6f7375 0%, #53575a 100%);
}

.status-banner.tone-cancel {
  background: linear-gradient(135deg, #fb6d6d 0%, #e64340 100%);
}

.status-text {
  font-size: 44rpx;
  font-weight: 700;
}

.status-desc {
  margin-top: 10rpx;
  font-size: 24rpx;
  opacity: 0.9;
}

/* ---------- 时间线 ---------- */

.timeline-card {
  margin-top: 20rpx;
  padding: 32rpx;
}

.cancel-reason {
  background: rgba(250, 81, 81, 0.08);
  color: var(--danger);
  font-size: 24rpx;
  padding: 16rpx 20rpx;
  border-radius: 10rpx;
  margin-bottom: 24rpx;
}

.timeline {
  padding-left: 8rpx;
}

.tl-node {
  position: relative;
  display: flex;
  padding-bottom: 36rpx;
  padding-left: 36rpx;
}

.tl-node:last-child {
  padding-bottom: 4rpx;
}

.tl-node::before {
  content: '';
  position: absolute;
  left: 13rpx;
  top: 28rpx;
  bottom: 0;
  width: 3rpx;
  background: #e3e5e7;
}

.tl-node:last-child::before {
  display: none;
}

.tl-dot {
  position: absolute;
  left: 4rpx;
  top: 8rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  background: #e3e5e7;
}

.tl-node.done .tl-dot {
  background: var(--brand);
}

.tl-node.current .tl-dot {
  background: var(--brand);
  box-shadow: 0 0 0 8rpx var(--brand-light);
}

.tl-label {
  font-size: 28rpx;
  color: var(--text-3);
}

.tl-node.done .tl-label,
.tl-node.current .tl-label {
  color: var(--text);
  font-weight: 600;
}

.tl-time {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
  min-height: 28rpx;
}

/* ---------- 菜品明细 ---------- */

.items-card {
  margin-top: 20rpx;
  padding: 28rpx 32rpx;
}

.o-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.o-item + .o-item {
  border-top: 1rpx solid var(--border);
}

.o-pic {
  width: 96rpx;
  height: 96rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f1f2;
}

.o-mid {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.o-name {
  font-size: 28rpx;
  font-weight: 600;
}

.o-spec {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.o-right {
  flex-shrink: 0;
  text-align: right;
}

.o-price {
  font-size: 26rpx;
}

.o-qty {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: var(--text-3);
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
  font-size: 24rpx;
  color: var(--text-3);
}

.total .price {
  font-size: 36rpx;
}

.total .price .rmb {
  font-size: 24rpx;
}

/* ---------- 订单信息 ---------- */

.info-card {
  margin-top: 20rpx;
  padding: 28rpx 32rpx;
}

.info-row {
  display: flex;
  justify-content: space-between;
  padding: 14rpx 0;
  font-size: 26rpx;
}

.label {
  color: var(--text-3);
  flex-shrink: 0;
}

.value {
  color: var(--text);
  text-align: right;
  margin-left: 40rpx;
}

.value.copy {
  color: var(--brand);
}

/* ---------- 操作区 ---------- */

.cancel-wrap {
  margin-top: 20rpx;
  text-align: center;
}

.cancel-btn {
  display: inline-block;
  color: var(--danger);
  font-size: 26rpx;
  padding: 16rpx 40rpx;
  border: 2rpx solid rgba(250, 81, 81, 0.4);
  border-radius: 999rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  gap: 20rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bar-btn {
  flex: 1;
}
