.page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  overflow: hidden;
  background: #fff;
}

/* ---------- 搜索框 ---------- */

.search-box {
  display: flex;
  align-items: center;
  margin: 20rpx 24rpx 0;
  height: 80rpx;
  border-radius: 40rpx;
  background: var(--bg);
  padding: 0 28rpx;
}

.search-icon {
  position: relative;
  width: 26rpx;
  height: 26rpx;
  border: 3rpx solid var(--text-3);
  border-radius: 50%;
  flex-shrink: 0;
}

.search-icon::after {
  content: '';
  position: absolute;
  right: -9rpx;
  bottom: -6rpx;
  width: 14rpx;
  height: 3rpx;
  background: var(--text-3);
  transform: rotate(45deg);
  border-radius: 2rpx;
}

.search-input {
  flex: 1;
  height: 100%;
  margin-left: 16rpx;
  font-size: 28rpx;
}

.ph {
  color: var(--text-3);
}

.clear {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #dcdedf;
  color: #fff;
  font-size: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

/* ---------- 热门搜索 ---------- */

.hot {
  padding: 40rpx 32rpx 0;
}

.hot-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 24rpx;
}

.hot-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.hot-chip {
  padding: 12rpx 32rpx;
  border-radius: 999rpx;
  background: var(--bg);
  color: var(--text-2);
  font-size: 26rpx;
}

/* ---------- 搜索结果 ---------- */

.result {
  flex: 1;
  min-height: 0;
  margin-top: 20rpx;
}

.result-list {
  padding: 0 32rpx 60rpx;
}
