.page {
  min-height: 100vh;
  padding: 20rpx 24rpx 220rpx;
}

/* ---------- 用餐信息 ---------- */

.table-card {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
}

.table-code {
  background: var(--brand);
  color: #fff;
  font-size: 30rpx;
  font-weight: 700;
  padding: 14rpx 24rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
}

.table-info {
  margin-left: 24rpx;
  min-width: 0;
}

.rest-name {
  font-size: 32rpx;
  font-weight: 600;
}

.rest-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* ---------- 菜品清单 ---------- */

.items-card {
  margin-top: 20rpx;
  padding: 28rpx 32rpx;
}

.item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
}

.item + .item {
  border-top: 1rpx solid var(--border);
}

.item-pic {
  width: 104rpx;
  height: 104rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #f0f1f2;
}

.item-info {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}

.item-name {
  font-size: 28rpx;
  font-weight: 600;
}

.item-spec {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.item-price {
  margin-top: 8rpx;
  color: var(--price);
  font-size: 28rpx;
  font-weight: 700;
}

.item-price .rmb {
  font-size: 22rpx;
}

.item-right {
  flex-shrink: 0;
  text-align: right;
}

.qty {
  font-size: 24rpx;
  color: var(--text-3);
}

.subtotal {
  margin-top: 8rpx;
  font-size: 28rpx;
  font-weight: 600;
}

.total-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding-top: 24rpx;
  border-top: 1rpx solid var(--border);
  font-size: 24rpx;
  color: var(--text-3);
}

.total .price {
  font-size: 36rpx;
}

.total .price .rmb {
  font-size: 24rpx;
}

.cart-empty {
  padding: 20rpx 0;
}

.go-ordering {
  margin: 0 60rpx;
}

/* ---------- 备注 ---------- */

.remark-card {
  margin-top: 20rpx;
  padding: 28rpx 32rpx;
  position: relative;
}

.remark-input {
  width: 100%;
  height: 160rpx;
  background: var(--bg);
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
}

.ph {
  color: var(--text-3);
}

.remark-count {
  position: absolute;
  right: 40rpx;
  bottom: 36rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

/* ---------- 底部提交栏 ---------- */

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #fff;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}

.bar-total {
  flex: 1;
}

.amount {
  color: var(--text);
  font-size: 38rpx;
  font-weight: 700;
}

.amount .rmb {
  font-size: 26rpx;
}

.hint {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--text-3);
}

.submit-btn {
  height: 92rpx;
  padding: 0 64rpx;
  border-radius: 46rpx;
  background: linear-gradient(135deg, var(--brand) 0%, var(--brand-deep) 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
}

.submit-btn.disabled {
  background: #c9c9c9;
}
