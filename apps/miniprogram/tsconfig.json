{
  "compilerOptions": {
    "strict": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "alwaysStrict": true,
    "esModuleInterop": true,
    "experimentalDecorators": true,
    "module": "CommonJS",
    "moduleResolution": "node",
    "target": "ES2020",
    "lib": [
      "ES2020"
    ],
    "typeRoots": [
      "./typings"
    ],
    "types": []
  },
  "include": [
    "miniprogram/**/*.ts",
    "typings/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "scripts"
  ]
}
