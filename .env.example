# 环境变量模板：复制为 .env 后按需修改（docker compose 自动读取同目录 .env）
# 生成强随机密钥：powershell -Command "[Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 } | ForEach-Object { [byte]$_ }))"
# 或（Git Bash / Linux）：openssl rand -base64 32

# [必填] JWT 签名密钥：不少于 32 字符，生产启动强校验，禁止使用演示密钥
JWT_SECRET=

# [可选] JWT 有效期（默认 12h）
# JWT_EXPIRES_IN=12h

# [可选] 跨域白名单，逗号分隔；留空不限制（建议收敛到管理后台域名）
# CORS_ORIGINS=https://admin.example.com

# [可选] 桌码二维码跳转模板，{code} 替换为桌号（小程序正式域名）
# QR_CONTENT_TEMPLATE=https://your-domain.example.com/mp?table={code}
