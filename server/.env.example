# 服务端口
PORT=3000

# PostgreSQL 连接串（docker compose 内由服务名组成，本地直连用 localhost）
DATABASE_URL=postgres://smarttable:smarttable@localhost:5432/smart_table

# Redis 连接（订单号序列）；留空则退化为进程内计数
REDIS_URL=redis://localhost:6379

# JWT 密钥与有效期（生产环境必须更换强随机密钥）
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=12h

# 首次启动播种演示数据（30 道菜 / 18 桌 / 近 30 天订单）
SEED_DEMO=true

# 允许 /api/dev/* 调试端点（演示重置数据用，生产必须为 false）
ALLOW_DEV_ENDPOINTS=false

# 桌码二维码内容模板，{code} 会替换为桌号
QR_CONTENT_TEMPLATE=https://smart-table.example.com/mp?table={code}
